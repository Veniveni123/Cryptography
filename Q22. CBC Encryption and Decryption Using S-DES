#include <stdio.h>

int main() {
    int p[4], c[4], d[4];
    int key=29, iv=170, prev;
    int i;

    printf("Enter four plaintext blocks (0-255):\n");

    for(i=0;i<4;i++)
        scanf("%d",&p[i]);

    prev=iv;

    printf("\nEncrypted blocks:\n");

    for(i=0;i<4;i++) {
        c[i]=p[i]^prev^key;
        printf("%02X ",c[i]);
        prev=c[i];
    }

    prev=iv;

    printf("\nDecrypted blocks:\n");

    for(i=0;i<4;i++) {
        d[i]=c[i]^prev^key;
        printf("%02X ",d[i]);
        prev=c[i];
    }

    return 0;
}
