#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char plain[]="send more money";
    char target[]="cash not needed";
    int key[]={9,0,1,7,23,15,21,14,11,11,2,8,9};
    char cipher[100], newkey[100];
    int i,j=0;

    printf("Encrypted text: ");

    for(i=0; plain[i]; i++) {
        if(isalpha(plain[i])) {
            int p=tolower(plain[i])-'a';
            cipher[j]=(p+key[j])%26+'a';
            printf("%c",cipher[j]);
            j++;
        }
        else if(plain[i]==' ')
            printf(" ");
    }

    cipher[j]='\0';

    printf("\n");

    j=0;

    for(i=0; target[i]; i++) {
        if(isalpha(target[i])) {
            int c=cipher[j]-'a';
            int p=tolower(target[i])-'a';

            newkey[j]=(c-p+26)%26;
            j++;
        }
    }

    printf("New key stream: ");

    for(i=0;i<j;i++)
        printf("%d ",newkey[i]);

    return 0;
}
