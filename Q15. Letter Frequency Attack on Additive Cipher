#include <stdio.h>
#include <string.h>

int main() {
    char text[500];
    int shift,i,n;

    printf("Enter ciphertext: ");
    fgets(text,sizeof(text),stdin);

    printf("Enter number of results: ");
    scanf("%d",&n);

    if(n>26) n=26;

    printf("\nPossible plaintexts:\n");

    for(shift=0;shift<n;shift++) {
        printf("\nShift %d: ",shift);

        for(i=0;text[i];i++) {
            if(text[i]>='A' && text[i]<='Z')
                putchar((text[i]-'A'-shift+26)%26+'A');
            else if(text[i]>='a' && text[i]<='z')
                putchar((text[i]-'a'-shift+26)%26+'a');
            else
                putchar(text[i]);
        }
    }

    return 0;
}
