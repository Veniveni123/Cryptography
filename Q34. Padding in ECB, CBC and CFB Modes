#include <stdio.h>
#include <string.h>

int main() {
    char text[100];
    int i,n,block=8;

    printf("Enter plaintext: ");
    fgets(text,sizeof(text),stdin);

    n=strcspn(text,"\n");

    printf("Padded text: ");

    for(i=0;i<n;i++)
        printf("%c",text[i]);

    printf("1");

    for(i=0;i<(block-(n+1)%block)%block;i++)
        printf("0");

    printf("\n");

    printf("Padding ensures unambiguous message length.");

    return 0;
}
