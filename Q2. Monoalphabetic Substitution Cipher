#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100];
    char key[] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i, x;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i] != '\0'; i++) {
        if (isupper(text[i])) {
            x = text[i] - 'A';
            text[i] = key[x];
        }
        else if (islower(text[i])) {
            x = text[i] - 'a';
            text[i] = tolower(key[x]);
        }
    }

    printf("Encrypted text: %s", text);

    return 0;
}
