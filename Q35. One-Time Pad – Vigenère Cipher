#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[200];
    int key[200],n,i;

    printf("Enter plaintext: ");
    fgets(text,sizeof(text),stdin);

    n=strcspn(text,"\n");

    printf("Enter key numbers for each letter:\n");

    int j=0;

    for(i=0;i<n;i++)
        if(isalpha(text[i]))
            scanf("%d",&key[j++]);

    j=0;

    printf("Encrypted text: ");

    for(i=0;i<n;i++) {
        if(isalpha(text[i])) {
            int p=tolower(text[i])-'a';
            printf("%c",(p+key[j])%26+'A');
            j++;
        }
        else
            printf("%c",text[i]);
    }

    return 0;
}
