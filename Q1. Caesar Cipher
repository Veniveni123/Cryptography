#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100], ch;
    int k, i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key (1-25): ");
    scanf("%d", &k);

    if (k < 1 || k > 25) {
        printf("Invalid key!");
        return 0;
    }

    for (i = 0; text[i] != '\0'; i++) {
        ch = text[i];

        if (isupper(ch))
            text[i] = (ch - 'A' + k) % 26 + 'A';
        else if (islower(ch))
            text[i] = (ch - 'a' + k) % 26 + 'a';
    }

    printf("Encrypted text: %s", text);

    return 0;
}
