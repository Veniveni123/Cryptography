#include <stdio.h>
#include <string.h>
#include <ctype.h>

char m[5][5] = {
    {'K','X','J','E','Y'},
    {'U','R','E','B','E'},
    {'Z','W','E','H','E'},
    {'W','R','Y','T','U'},
    {'H','E','Y','F','S'}
};

int main() {
    char text[500];
    int i, j, r1, c1, r2, c2;

    printf("Enter ciphertext (letters only): ");
    fgets(text, sizeof(text), stdin);

    printf("\nDecrypted text: ");

    for (i = 0; text[i] && text[i+1]; i += 2) {
        char a = toupper(text[i]);
        char b = toupper(text[i+1]);

        for (r1=0; r1<5; r1++)
            for (c1=0; c1<5; c1++)
                if (m[r1][c1] == a) goto first;

        first:

        for (r2=0; r2<5; r2++)
            for (c2=0; c2<5; c2++)
                if (m[r2][c2] == b) goto second;

        second:

        if (r1 == r2) {
            putchar(m[r1][(c1+4)%5]);
            putchar(m[r2][(c2+4)%5]);
        }
        else if (c1 == c2) {
            putchar(m[(r1+4)%5][c1]);
            putchar(m[(r2+4)%5][c2]);
        }
        else {
            putchar(m[r1][c2]);
            putchar(m[r2][c1]);
        }
    }

    return 0;
}
