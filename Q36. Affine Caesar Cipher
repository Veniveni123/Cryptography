#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a,int b) {
    while(b) {
        int t=b;
        b=a%b;
        a=t;
    }
    return a;
}

int main() {
    char text[100];
    int a,b,i,p;

    printf("Enter plaintext: ");
    fgets(text,sizeof(text),stdin);

    printf("Enter a and b: ");
    scanf("%d%d",&a,&b);

    if(gcd(a,26)!=1) {
        printf("Invalid key!");
        return 0;
    }

    printf("Encrypted text: ");

    for(i=0;text[i];i++) {
        if(isalpha(text[i])) {
            p=toupper(text[i])-'A';
            printf("%c",(a*p+b)%26+'A');
        }
        else
            printf("%c",text[i]);
    }

    return 0;
}
