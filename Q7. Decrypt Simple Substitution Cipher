#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[1000];
    char cipher[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    char plain[]  = "ETAOINSHRDLCUMWFGYPBVKJXQZ";
    int i, j;

    printf("Enter ciphertext:\n");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i]; i++) {
        if (isalpha(text[i])) {
            int upper = isupper(text[i]);
            char ch = toupper(text[i]);

            for (j = 0; j < 26; j++) {
                if (cipher[j] == ch) {
                    text[i] = upper ? plain[j] : tolower(plain[j]);
                    break;
                }
            }
        }
    }

    printf("\nApproximate decrypted text:\n%s", text);

    return 0;
}
