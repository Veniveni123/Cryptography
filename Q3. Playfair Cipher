#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void generateKey(char key[]) {
    int used[26] = {0};
    int i, j, k = 0;
    char ch;

    used['J' - 'A'] = 1;

    for (i = 0; key[i]; i++) {
        ch = toupper(key[i]);

        if (ch == 'J') ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch-'A']) {
            matrix[k/5][k%5] = ch;
            used[ch-'A'] = 1;
            k++;
        }
    }

    for (i = 0; i < 26; i++) {
        if (!used[i]) {
            matrix[k/5][k%5] = 'A' + i;
            k++;
        }
    }
}

void encrypt(char text[]) {
    int i, r1, c1, r2, c2;

    for (i = 0; text[i]; i += 2) {
        for (r1 = 0; r1 < 5; r1++)
            for (c1 = 0; c1 < 5; c1++)
                if (matrix[r1][c1] == text[i]) goto found1;

        found1:

        for (r2 = 0; r2 < 5; r2++)
            for (c2 = 0; c2 < 5; c2++)
                if (matrix[r2][c2] == text[i+1]) goto found2;

        found2:

        if (r1 == r2) {
            text[i] = matrix[r1][(c1+1)%5];
            text[i+1] = matrix[r2][(c2+1)%5];
        }
        else if (c1 == c2) {
            text[i] = matrix[(r1+1)%5][c1];
            text[i+1] = matrix[(r2+1)%5][c2];
        }
        else {
            text[i] = matrix[r1][c2];
            text[i+1] = matrix[r2][c1];
        }
    }
}

int main() {
    char key[100], text[200], temp[200];
    int i, j, k = 0;

    printf("Enter keyword: ");
    scanf("%s", key);

    printf("Enter plaintext: ");
    scanf(" %[^\n]", text);

    for (i = 0; text[i]; i++) {
        if (isalpha(text[i])) {
            char ch = toupper(text[i]);
            if (ch == 'J') ch = 'I';
            temp[k++] = ch;
        }
    }

    temp[k] = '\0';

    k = 0;

    for (i = 0; temp[i]; i++) {
        temp[k++] = temp[i];

        if (temp[i+1] && temp[i] == temp[i+1])
            temp[k++] = 'X';
    }

    if (k % 2 != 0)
        temp[k++] = 'X';

    temp[k] = '\0';

    generateKey(key);
    encrypt(temp);

    printf("Encrypted text: %s\n", temp);

    return 0;
}
