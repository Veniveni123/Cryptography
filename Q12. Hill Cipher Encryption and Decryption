#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[200], cipher[200];
    int a=9, b=4, c=5, d=7;
    int det, inv=-1, i, x, y, p, q;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    int n=0;

    for(i=0; text[i]; i++)
        if(isalpha(text[i]))
            text[n++] = tolower(text[i]);

    if(n%2) text[n++]='x';

    text[n]='\0';

    det = (a*d-b*c+2600)%26;

    for(i=1; i<26; i++)
        if((det*i)%26==1) inv=i;

    if(inv==-1) {
        printf("Key is not invertible.");
        return 0;
    }

    for(i=0; i<n; i+=2) {
        p=text[i]-'a';
        q=text[i+1]-'a';

        x=(a*p+b*q)%26;
        y=(c*p+d*q)%26;

        cipher[i]=x+'a';
        cipher[i+1]=y+'a';
    }

    cipher[n]='\0';

    printf("Encrypted text: %s\n",cipher);

    printf("Decrypted text: ");

    for(i=0; i<n; i+=2) {
        x=cipher[i]-'a';
        y=cipher[i+1]-'a';

        p=((d*x-b*y)*inv%26+26)%26;
        q=((-c*x+a*y)*inv%26+2600)%26;

        printf("%c%c",p+'a',q+'a');
    }

    return 0;
}
